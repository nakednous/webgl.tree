{
  "name": "webgl.tree",
  "version": "0.0.6",
  "description": "webgl.tree — @nakednous/tree + @nakednous/host on raw WebGL2: gizmo line pipe, HUD, render targets, filter passes, the pipe chain, async colour-ID picking, camera install.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "jsdelivr": "dist/webgl.tree.js",
  "unpkg": "dist/webgl.tree.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "test": "node --test test/",
    "build": "rollup -c",
    "docs": "node tools/docs/index.js",
    "clean": "rm -rf dist site",
    "rebuild": "npm run clean && npm run build",
    "reset": "rm -rf node_modules dist package-lock.json && npm install",
    "link:core": "npm link @nakednous/tree @nakednous/host",
    "unlink:core": "npm unlink --no-save @nakednous/tree @nakednous/host && npm install @nakednous/tree @nakednous/host",
    "prepublishOnly": "npm run rebuild",
    "postpublish": "npm run link:core"
  },
  "keywords": [
    "webgl",
    "webgl2",
    "twgl",
    "graphics",
    "tree",
    "shader",
    "gizmo",
    "picking",
    "framebuffer",
    "camera",
    "manipulator"
  ],
  "author": "Jean Pierre Charalambos <nakednous@gmail.com>",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nakednous/webgl.tree.git"
  },
  "peerDependencies": {
    "twgl.js": ">=5.5.4"
  },
  "dependencies": {
    "@nakednous/host": "^0.0.8",
    "@nakednous/tree": "^0.0.31"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "comment-parser": "^1.4.9",
    "marked": "^18.0.14",
    "rollup": "^4.63.5"
  }
}
